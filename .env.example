GEOSERVER_ADMIN_USER=<admin_geoserver>
GEOSERVER_ADMIN_PASSWORD=<password_geoserver>
RESET_ADMIN_CREDENTIALS=<TRUE or FALSE>
GEOSERVER_CONTEXT_ROOT=sextante
GEOSERVER_DATA_DIR=/opt/geoserver/data_dir
STABLE_EXTENSIONS=geopkg-output-plugin,wps-download-plugin
ENABLE_JSONP=true
MAX_FILTER_RULES=20
OPTIMIZE_LINE_WIDTH=false
PROXY_HOST=<domain>
PROXY_PORT=<proxy_port>
TOMCAT_SECURE=true
GEOSERVER_PROXY_BASE_URL=https://${PROXY_HOST}/sextante
GEOSERVER_CSRF_WHITELIST=<domain>,<domain_2>,<ip>
HTTP_SCHEME=<http_scheme>
INITIAL_MEMORY=<initial_memory>
MAXIMUM_MEMORY=<maximum_memory>
ADDITIONAL_JAVA_STARTUP_OPTIONS="<additional_java_opts>"
GEOSERVER_XSTREAM_WHITELIST=<>
POSTGIS_HOST=<postgis_host>
POSTGIS_PORT=<postgis_port>
POSTGIS_DB=<postgis_db>
POSTGIS_USER=<postgis_user>
POSTGIS_PASSWORD=<postgis_password>
POSTGIS_SSLMODE=allow
GS_CONTROLFLOW_TIMEOUT=<timeout_seconds>
GS_CONTROLFLOW_OWS_GLOBAL=<global_requests>
GS_CONTROLFLOW_OWS_WMS_GETMAP=<getmap_requests>
GS_CONTROLFLOW_OWS_WFS_MSEXCEL=<msexcel_requests>
GS_CONTROLFLOW_OWS_GWC=<gwc_requests>
GS_CONTROLFLOW_USER=<user_requests>
GS_CONTROLFLOW_USER_WPS_EXECUTE="<wps_execute_limit>"
GS_CONTROLFLOW_USER_WMS_GETMAP="<getmap_rate_limit>"
GS_CONTROLFLOW_IP=<ip_requests>

VERSION_API_PORT=<version_api_port>
ONTOY_DISK_PATH=<ruta-del-filesystem-que-se-mide>
GEOSERVER_BIND_ADDR=<ip-de-bind-de-tomcat>
GEOSERVER_PORT=<puerto-de-tomcat-en-el-host>
VERSION_API_BIND_ADDR=<ip-de-bind-del-sidecar-ontoy>

MAPALAB_API_URL=<url-interna-del-api-de-mapalab-incluyendo-/api>

GEOWEBCACHE_CACHE_DIR=<ruta-del-blobstore-de-gwc-dentro-del-contenedor-fuera-del-data_dir>
GWC_CACHE_HOST_DIR=<ruta-del-blobstore-en-el-host-relativa-con-./-o-absoluta>

# Contrato /ontoy: nodo al que pertenece este servicio y quien reporta el host.
# Solo UN servicio por nodo lleva ONTOY_NODE_REPORTER=true.
ONTOY_NODE=<nodo donde corre, p.ej. S3>
ONTOY_NODE_REPORTER=<true en el reportero del nodo, false en los demas>
# Aristas hacia otros nodos para la matriz de conectividad. Vacia si no aplica.
ONTOY_PEER_CHECKS=<S4=10.0.0.4:6432>
