GEOSERVER_ADMIN_USER=<admin_geoserver>
GEOSERVER_ADMIN_PASSWORD=<password_geoserver>
RESET_ADMIN_CREDENTIALS=<TRUE or FALSE>
GEOSERVER_DATA_DIR=/opt/geoserver/data_dir
ENABLE_JSONP=true
MAX_FILTER_RULES=20
OPTIMIZE_LINE_WIDTH=false
PROXY_HOST=<domain>
PROXY_PORT=<proxy_port>
GEOSERVER_PROXY_BASE_URL=https://${PROXY_HOST}/geoserver
GEOSERVER_CSRF_WHITELIST=<domain>,<domain_2>
HTTP_SCHEME=https
JAVA_OPTS=<>
POSTGIS_HOST=<postgis_host>
POSTGIS_PORT=<postgis_port>
POSTGIS_DB=<postgis_db>
POSTGIS_USER=<postgis_user>
POSTGIS_PASSWORD=<postgis_password>
POSTGIS_SSLMODE=allow