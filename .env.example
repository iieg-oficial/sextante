GEOSERVER_ADMIN_USER=<admin_geoserver>
GEOSERVER_ADMIN_PASSWORD=<password_geoserver>
RESET_ADMIN_CREDENTIALS=<TRUE or FALSE>
GEOSERVER_DATA_DIR=/opt/geoserver/data_dir
ENABLE_JSONP=true
MAX_FILTER_RULES=20
OPTIMIZE_LINE_WIDTH=false
PROXY_HOST=<domain>
PROXY_PORT=<proxy_port>
TOMCAT_SECURE=true
GEOSERVER_PROXY_BASE_URL=https://${PROXY_HOST}/geoserver
GEOSERVER_CSRF_WHITELIST=<domain>,<domain_2>,<ip>
HTTP_SCHEME=https
# Tuning JVM via variables nativas de kartoza/geoserver. La imagen ya define G1GC,
# Marlin renderer, encoding, etc. en su GEOSERVER_OPTS interno; meter flags raw en
# JAVA_OPTS colisiona (dos -Xmx, parsing roto). Usar las vars nativas en su lugar:
#   INITIAL_MEMORY                     -> -Xms
#   MAXIMUM_MEMORY                     -> -Xmx
#   ADDITIONAL_JAVA_STARTUP_OPTIONS    -> flags extras al final (ej. Metaspace)
#
# Valores recomendados por entorno (ver gateway-hub/docs/recursos-servidores.md):
#   Local / GCP Staging (VM compartida 2c/8GB):
#       INITIAL_MEMORY=1G  MAXIMUM_MEMORY=2G  ADDITIONAL_JAVA_STARTUP_OPTIONS=-XX:MaxMetaspaceSize=512m
#   Produccion S3 (VM dedicada 8c/15GB):
#       INITIAL_MEMORY=2G  MAXIMUM_MEMORY=8G  ADDITIONAL_JAVA_STARTUP_OPTIONS=-XX:MaxMetaspaceSize=1g
INITIAL_MEMORY=<initial_memory>
MAXIMUM_MEMORY=<maximum_memory>
ADDITIONAL_JAVA_STARTUP_OPTIONS=<additional_java_opts>
GEOSERVER_XSTREAM_WHITELIST=<>
POSTGIS_HOST=<postgis_host>
POSTGIS_PORT=<postgis_port>
POSTGIS_DB=<postgis_db>
POSTGIS_USER=<postgis_user>
POSTGIS_PASSWORD=<postgis_password>
POSTGIS_SSLMODE=allow